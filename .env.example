# ─── Database ────────────────────────────────────────
# "postgres" = Docker container name (used by apps inside Docker)
# "localhost" = for scripts running on the host machine
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://emailplatform:${DB_PASSWORD}@localhost:5432/emailplatform

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Haraka SMTP ─────────────────────────────────────
HARAKA_HOST=localhost
HARAKA_PORT=587
HARAKA_USER=system
HARAKA_PASS=CHANGE_ME

# ─── Tracking ───────────────────────────────────────
TRACKING_DOMAIN=t.yourdomain.com
TRACKING_PORT=3001

# ─── MinIO ───────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# ─── Email ───────────────────────────────────────────
SENDING_DOMAIN=yourdomain.com
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=YourCompany
