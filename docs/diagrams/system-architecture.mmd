flowchart TB
    subgraph Client["CLIENT LAYER"]
        Web["Web App (Next.js)"]
        API["External API"]
    end

    subgraph App["APPLICATION SERVERS"]
        API1["API Server"]
        API2["API Server"]
        Tracking["Tracking Server"]
    end

    subgraph Queue["QUEUE SYSTEM (Redis + BullMQ)"]
        Q1["campaign:process"]
        Q2["email:send"]
        Q3["events:track"]
    end

    subgraph Workers["WORKERS"]
        W1["Campaign Worker"]
        W2["Email Worker"]
        W3["Event Worker"]
    end

    subgraph Mail["HARAKA MAIL SERVER"]
        Auth["auth_api"]
        DKIM["dkim_sign"]
        Delivery["outbound"]
    end

    subgraph Data["DATA LAYER"]
        PG[("PostgreSQL")]
        Redis[("Redis")]
        S3[("MinIO")]
    end

    Web --> API1 & API2
    API --> API1 & API2
    API1 & API2 --> Q1
    Q1 --> W1
    W1 --> Q2
    Q2 --> W2
    W2 --> Auth --> DKIM --> Delivery
    Delivery -.-> Internet((Recipients))
    Internet -.-> Tracking
    Tracking --> Q3
    Q3 --> W3
    W3 --> PG
    API1 & API2 --> PG
    API1 & API2 --> Redis
